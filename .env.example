# Copy to .env outside the public document root. Never commit or publish .env.
APP_ENV=local
APP_URL=http://localhost:8000
LOG_LEVEL=warning

# MySQL (set values for MySQL; leave host/database/user/password empty for JSON dev storage)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Admin access: set a unique username and long password before deployment.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD_HASH=replace-with-output-from-password_hash

# Legacy Node backend only: generate with `npm run admin:hash` and set a distinct scrypt hash.
NODE_ADMIN_PASSWORD_HASH=
PUBLIC_BASE_URL=http://localhost:3000

# SMTP/PHPMailer. SMTP_HOST may remain empty until email is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=MatAi 2027
ADMIN_NOTIFICATION_EMAIL=

# Payment credentials: use test/sandbox values until provider flows are verified.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_USD_CHECKOUT_VERIFIED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_USD_CHECKOUT_VERIFIED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=USD
RAZORPAY_USD_CHECKOUT_VERIFIED=false
