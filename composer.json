{
  "name": "matai/matai-2027",
  "description": "MatAi 2027 conference site PHP backend",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "phpmailer/phpmailer": "^7.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "MatAi\\": "backend/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MatAi\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress",
    "check": [
      "@test",
      "@analyse"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
